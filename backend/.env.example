# Server Config
PORT=8000
HOST=127.0.0.1

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key for Email OTP Verification
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=EduMind Security <onboarding@resend.dev>

# MongoDB Atlas Database & Cloud GridFS
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/edumind?retryWrites=true&w=majority
DB_NAME=edumind

# JWT Auth Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Gmail Configuration (Zero-DNS setup via Google App Password)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
